(rule
 (target cpp_environment)
 (deps
  (universe)
  (env_var CPP2V_DOCKER_ENABLED)
  (env_var CPP2V_DOCKER_IMAGE)
  (env_var CPP2V_DOCKER_USER))
 (action
  (with-stdout-to %{target}
   (run %{bin:cpp2v-toolchain} configure
    --default-image skylabsai/fm-releases:fm-release-nightly
    --platform linux/amd64 --opam))))

(env
 (sl_timing
  (binaries (../BRiCk/rocq-tools/bin/rocq_perf.exe as rocq))
  (rocq
   (rocqdep_flags :standard -w +all)
   (flags :standard %{read-lines:flags/coqc} -w +sl-transparent-constants)))
 ; Same, but without rocq_perf
 (_
  (rocq
   (rocqdep_flags :standard -w +all)
   (flags :standard %{read-lines:flags/coqc} -w +sl-transparent-constants))))

; Expose the cpp2v configuration to configured inline quotations in the
; PM-managed proofs theory. The .v target orders generation before rocq dep.
(subdir proof
 (subdir proofs
  (rule
   (targets cpp_environment cpp_environment_dependency.v)
   (deps (:config ../../cpp_environment))
   (action
    (progn
     (copy %{config} cpp_environment)
     (write-file cpp_environment_dependency.v
      "(* Builds the inline toolchain configuration before rocq dep. *)\n"))))))
