#!/usr/bin/env bash

REALPATH=$(which grealpath || which realpath)
SED=$(which gsed || which sed)
REL_PATH="$($REALPATH `pwd` --relative-to "$DUNE_SOURCEROOT")"

map_absolute_paths () {
    while [[ $# -gt 0 ]]; do
        if [[ $1 =~ /.*\.(v|cpp|hpp|h|c) ]] && [[ -f "$1" ]]; then
            local dir="$(dirname "$1")"
            echo "--volume" "$dir:$dir"
        fi
        shift
    done
}

check_lib_cpp_flag () {
    while [[ $# -gt 0 ]]; do
        if [[ $1 == -stdlib=libstdc++ ]]; then
            return 0
        fi
        shift
    done
    return 1
}

if [ -n "$IN_CPP2V_DOCKER" ]; then
  echo "Error: recursive invocation of \"cpp2v_docker\" as $0 from outer cpp2v_docker as ${IN_CPP2V_DOCKER}"
  echo "(PATH is $PATH)."
  exit 1
fi

ENABLED_VALUES="y|n|if-libstdc\+\+"
if ! [[ $CPP2V_DOCKER_ENABLED =~ $ENABLED_VALUES ]]; then
    echo "Misconfiguration: CPP2V_DOCKER_ENABLED'$CPP2V_DOCKER_ENABLED'"
    echo "It should have one of '$ENABLED_VALUES'"
    exit 2
fi

if [ "$CPP2V_DOCKER_ENABLED" = "if-libstdc++" ] \
   && check_lib_cpp_flag "$@" ; then
    CPP2V_DOCKER_ENABLED=y
fi

if [ "$CPP2V_DOCKER_ENABLED" = "y" ] && ! which docker > /dev/null; then
  # Here we could warn
  :
fi

units () {
    local pat='s/G/000M/;s/M/000K/;s/K/000B/;s/B//g'
    if [[ $# -eq 1 ]]; then
      echo "$1" | $SED $pat
    else
      $SED $pat
    fi
}

if [ "$CPP2V_DOCKER_ENABLED" = "y" ] && which docker > /dev/null; then
  if [ -z "$CPP2V_DOCKER_IMAGE" ]; then
    # We skip the warning if no docker is available
    echo "Misconfiguration: CPP2V_DOCKER_ENABLED = y and docker available, but CPP2V_DOCKER_IMAGE is empty"
    exit 2
  fi

  BRICK_LIBCPP=/home/coq/worktree
  ARGS=()
  ARGS+=( "--platform" "linux/amd64" )
  ARGS+=( "--volume" "${HOME}/.cache/remote_dune:/home/coq/.cache/dune:cached" )
  ARGS+=( "--volume" "$DUNE_SOURCEROOT:$BRICK_LIBCPP" )
  ARGS+=( "--workdir" "$BRICK_LIBCPP/$REL_PATH" )
  ARGS+=( $(map_absolute_paths "$@") )

  if [[ -n "$CPP2V_DOCKER_MEM_CAP" ]]; then
    MEM_CAP=$(units $CPP2V_DOCKER_MEM_CAP)
    if ! [[ $MEM_CAP =~ [0-9]+ ]]; then
      echo "Misconfiguration: CPP2V_DOCKER_MEM_CAP = '$CPP2V_DOCKER_MEM_CAP', invalid memory amount"
      exit 2
    fi
    while true; do
        used_mem=$(docker stats --no-stream --format "{{.MemUsage}}" | awk '{print $1}' | head -n 1 | units)
        if [[ "$used_mem" -lt $MEM_CAP ]]; then
            break
        fi
        sleep 0.01
    done
  fi

  cpp2v_args="$( printf '"%q" ' "$@" )" # ensure each argument is quoted as a whole.
  docker run "${ARGS[@]}" "$CPP2V_DOCKER_IMAGE" \
          /bin/bash -c 'eval $(opam env)'"; cpp2v $cpp2v_args"
else
  export IN_CPP2V_DOCKER="$0"
  next=$DUNE_SOURCEROOT/_build/install/default/bin/cpp2v
  [ -e $next ] || next='opam exec -- cpp2v'
  exec $next "$@"
fi

# We embed these hashes just to track dependencies.
# CPP2V_SHA1="@CPP2V_SHA1@"
# CPP2V_DOCKER_IMAGE_ID="@CPP2V_DOCKER_IMAGE_ID@"
