(include_subdirs qualified)
(rocq.theory
 (name skylabs.brick.libstdcpp.test) ; logical path of this library
 (generate_project_file)
 (theories
  rocq-stdlib
  rocq-iris
  rocq-skylabs-iris
  rocq-skylabs-brick
  rocq-skylabs-brick-cpp-prog
  rocq-skylabs-auto-cpp
  rocq-brick-libstdcpp))
(include dune.inc)

; Check the glibc ABI assumptions of the pthread mutex proof clients.
(subdir pthread
 (rule
  (targets mutex_native.exe)
  (deps mutex.cpp owner.cpp)
  (action
   (run %{bin:clang++} -std=c++20 -pthread -DPTHREAD_MUTEX_NATIVE_TEST
    -Wall -Wextra -Werror %{dep:mutex.cpp} %{dep:owner.cpp} -o mutex_native.exe)))
 (rule
  (alias runtest)
  (action (run ./mutex_native.exe))))

; An executable counterexample to the current generic scoped_lock contract.
(rule
 (alias runtest)
 (action
  (run %{bin:cpp2v-run}
   --config %{dep:../cpp_environment}
   -- python3 %{dep:mutex/scoped_lock_counterexample.py} clang++
   %{dep:mutex/scoped_lock_counterexample.cpp})))

(rule
 (alias runtest)
 (action
  (run %{bin:cpp2v-run}
   --config %{dep:../cpp_environment}
   -- python3 %{dep:mutex/recursive_mutex_odr.py} clang++
   %{dep:mutex/custom_recursive_mutex.hpp})))

(rule
 (action (with-stdout-to dune.inc.gen (run ./dune-gen.sh)))
 (deps (glob_files_rec *.{h,c,hpp,cpp,sh})))

(rule
 (alias dune_inc)
 (action (diff dune.inc dune.inc.gen)))

; clang must flag every call in cstring/null_ub.cpp as passing null to a
; nonnull parameter (see that file).
(subdir cstring
 (rule
  (action
   (with-stdout-to null_ub.warnings
    (run sed -n "s|^.*/\\(null_ub\\.cpp:[0-9:]*: warning: .*\\)$|\\1|p"
     %{dep:null_ub_cpp.v.stderr}))))
 (rule
  (alias runtest)
  (action (diff null_ub.warnings.expected null_ub.warnings))))
