; The build directory is directly below the source workspace, so the relation
; between the target and this workspace path is unchanged by sandboxing.

(rule
 (target cpp_environment)
 (deps
  (universe)
  (env_var CPP2V_DOCKER_ENABLED)
  (env_var CPP2V_DOCKER_IMAGE)
  (env_var CPP2V_DOCKER_USER))
 (action
  (run
   %{bin:cpp2v-toolchain}
   configure
   --workspace
   %{workspace_root}/../..
   --output
   %{target}
   --default-image
   skylabsai/fm-releases:fm-release-nightly
   --platform
   linux/amd64
   --opam)))

(env
 (sl_timing
  (rocq
   (wrapper ../../BRiCk/rocq-tools/bin/rocq_perf.exe)
   (rocqdep_flags :standard -w +all)
   (flags :standard %{read-lines:flags/coqc} -w +sl-transparent-constants)))
 ; Same, but without rocq_perf
 (_
  (rocq
   (rocqdep_flags :standard -w +all)
   (flags :standard %{read-lines:flags/coqc} -w +sl-transparent-constants))))
