(rule
 (target cpp_environment)
 (deps
  (universe)
  (env_var CPP2V_DOCKER_ENABLED)
  (env_var CPP2V_DOCKER_IMAGE)
  (env_var CPP2V_DOCKER_USER))
 (action
  (with-stdout-to %{target}
   (run %{bin:cpp2v-toolchain} configure
    --default-image skylabsai/fm-releases:fm-release-nightly
    --platform linux/amd64 --opam))))

(env
 (sl_timing
  (binaries (../../BRiCk/rocq-tools/bin/rocq_perf.exe as rocq))
  (rocq
   (rocqdep_flags :standard -w +all)
   (flags :standard %{read-lines:flags/coqc} -w +sl-transparent-constants)))
 ; Same, but without rocq_perf
 (_
  (rocq
   (rocqdep_flags :standard -w +all)
   (flags :standard %{read-lines:flags/coqc} -w +sl-transparent-constants))))
