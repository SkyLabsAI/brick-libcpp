(include_subdirs qualified)
(rocq.theory
 (name skylabs.brick.libstdcpp) ; logical path of this library
 (public_name rocq-brick-libstdcpp)
 (package rocq-brick-libstdcpp)
 (generate_project_file)
 (theories
  rocq-stdlib
  rocq-stdpp
  rocq-skylabs-prelude
  rocq-iris
  rocq-skylabs-iris
  rocq-skylabs-brick
  rocq-skylabs-brick-cpp-prog
  rocq-skylabs-auto-core
  rocq-skylabs-auto-cpp))
(include dune.inc)

; Expose the existing configuration once for configured inline quotations in
; this theory and its clients. The .v target orders generation before rocq dep.
; Rebase the parent's relative workspace for this directory.
(rule
 (target cpp_environment)
 (deps (:config ../cpp_environment))
 (action (run %{bin:cpp2v-toolchain} copy %{config} %{target})))

(rule
 (target cpp_environment_dependency.v)
 (deps cpp_environment)
 (action
  (write-file %{target}
   "(* Builds the inline toolchain configuration before rocq dep. *)\n")))

(rule
 (action (with-stdout-to dune.inc.gen (run ./dune-gen.sh)))
 (deps (glob_files_rec *.{h,c,hpp,cpp,sh})))

(rule
 (alias dune_inc)
 (action (diff dune.inc dune.inc.gen)))
